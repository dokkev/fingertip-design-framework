<?xml version="1.0"?>
<robot name="sphere_15mm">
  <!-- Dimensions are in metres: 15 mm diameter, 7.5 mm radius. -->
  <link name="sphere">
    <visual>
      <geometry>
        <sphere radius="0.0075"/>
      </geometry>
      <material name="sphere_gray">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <sphere radius="0.0075"/>
      </geometry>
    </collision>
  </link>
</robot>
